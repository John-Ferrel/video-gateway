# ---------------------------------------------------------------------------
# Video Gateway configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# API authentication. Comma-separated slots; each slot has its own video and
# batch library. Budget, Usage, storage and the GPU queue are shared. The first
# slot is the admin key. Keep existing slots in place when rotating a value;
# append a new slot for a new person. If empty, the gateway generates
# data/api_key on first start (0600) and that key is slot 0.
API_KEYS=

# Absolute paths are recommended in production.
DATA_DIR=./data
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=INFO

# "modal" = real GPU worker, "local" = demo/test backend, "auto" = modal if
# credentials are present, otherwise local with a visible warning.
VIDEO_BACKEND=auto

# --- Modal -----------------------------------------------------------------
# Use `modal token set` or MODAL_TOKEN_ID / MODAL_TOKEN_SECRET.
MODAL_APP_NAME=video-gateway-worker
MODAL_FUNCTION_NAME=generate
MODAL_ENVIRONMENT=
MODAL_MODELS_VOLUME=video-gateway-models
MODAL_RESULTS_VOLUME=video-gateway-results
MODAL_PROGRESS_DICT=video-gateway-progress
# Worker resources. Keep in sync with worker/modal_app.py.
WORKER_GPU=RTX-PRO-6000
WORKER_CPU=4
WORKER_MEMORY_GIB=96
WORKER_SCALEDOWN_SECONDS=10
# FastVideo main commit used by the worker image. PyPI 0.2.1 predates
# FastH3/MiniMax H3 support, so this must be a commit with the minimax_h3
# modules and the H3 NVFP4/VSA kernels.
FASTVIDEO_REF=c938a8aa2b856a594f791a61875ba0bdac5ef318

# --- Budget ----------------------------------------------------------------
# Modal Starter included $30/month of compute at the time of measurement;
# check Modal's current pricing and set your own limits. Keep a safety reserve.
MONTHLY_CREDITS_USD=30
MONTHLY_SOFT_BUDGET_USD=28
BILLING_CYCLE_DAY=1
# Reject a single job whose worst-case cold estimate exceeds this.
MAX_JOB_ESTIMATE_USD=0.75
MAX_JOBS_PER_DAY=50
MAX_QUEUE=24

# Optional sync from Modal's official billing API. Some plans may not expose
# it; the gateway then falls back to conservative estimated metering and
# exposes the source in /usage.
BILLING_SYNC_ENABLED=true
BILLING_SYNC_INTERVAL_SECONDS=900

# --- Limits / retention ----------------------------------------------------
MAX_UPLOAD_BYTES=12582912
RETENTION_DAYS=30
MAX_STORAGE_GB=20
JOB_TIMEOUT_SECONDS=1800
MAX_BATCH_SIZE=20
ALLOW_REMOTE_REFERENCES=false

# Content URLs handed to the browser are short-lived HMAC tokens.
CONTENT_TOKEN_TTL_SECONDS=3600

# --- FFmpeg ----------------------------------------------------------------
# Leave empty to use system ffmpeg, then imageio-ffmpeg's bundled binary.
FFMPEG_BIN=

# Optional public origin used in docs/UI (e.g. https://video.example.com).
PUBLIC_BASE_URL=

# --- H3 prompt enhancement ------------------------------------------------
# Any OpenAI-compatible chat endpoint, including CLIProxyAPI. Leave the base
# URL or model empty to disable enhancement; the gateway then uses the prompt
# as written. The official H3 Context-IR service is hosted; this is a local,
# replaceable prompt-enhancement approximation built from the official guides.
# opencode-go OpenAI-compatible endpoint (DeepSeek V4.1 Flash):
# H3_PROMPT_ENHANCER_BASE_URL=https://opencode.ai/inference/go/openai/v1
# H3_PROMPT_ENHANCER_MODEL=deepseek-v4.1-flash
# H3_PROMPT_ENHANCER_API_KEY=<key>
# H3_PROMPT_ENHANCER_OPENCODE_SESSION=ses_...  # sent as x-opencode-session
# Any other OpenAI-compatible endpoint works too:
# H3_PROMPT_ENHANCER_BASE_URL=http://127.0.0.1:8317/v1
# H3_PROMPT_ENHANCER_TIMEOUT_SECONDS=180
H3_PROMPT_ENHANCER_ENABLED=true

# Open-H3-Regenerate-2K is gated: ~150 GiB GPU / 164.9 GB weights.
REGENERATE_HD_ENABLED=false
