[Unit]
Description=Video Gateway (FastAPI + Modal video worker)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/video-gateway
Environment=ENV_FILE=/opt/video-gateway/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/video-gateway/.venv/bin/python -m gateway.main
Restart=always
RestartSec=3
# Modest hardening; the service is a single-user gateway.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/video-gateway/data

[Install]
WantedBy=default.target
